<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Biệt danh"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#666666" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutUserMish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- Item 1: Người dùng hiện tại -->
        <RelativeLayout
            android:id="@+id/itemMyNickname"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvMyAvatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerVertical="true"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgMyAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo2" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/cvMyAvatar"
                android:layout_toStartOf="@id/btnEditMyNickname"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMyRealName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên của bạn"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMyNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đặt biệt danh"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnEditMyNickname"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#000000" />
        </RelativeLayout>

        <!-- Item 2: Người nhận -->
        <RelativeLayout
            android:id="@+id/itemReceiverNickname"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvReceiverAvatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerVertical="true"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgReceiverAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo2" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/cvReceiverAvatar"
                android:layout_toStartOf="@id/btnEditReceiverNickname"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReceiverRealName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên người kia"
                    android:textColor="#000000"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReceiverNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đặt biệt danh"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnEditReceiverNickname"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#000000" />
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
